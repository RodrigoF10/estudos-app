<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head', { title: theme.name + ' — Estudos CEFET-MG' }) %>
</head>
<body>
  <%- include('../partials/nav', { role, active: 'trilha' }) %>
  <div class="container">

    <p><a href="/rayane/materia/<%= subject.slug %>">← Voltar para <%= subject.name %></a></p>

    <%
      const lv = { 1: 0, 2: 0, 3: 0 };
      byLevel.forEach(function(r) { lv[r.level] = (lv[r.level] || 0) + r.c; });
    %>

    <div class="card">
      <span class="badge badge-<%= stats.level.key %>"><%= stats.level.emoji %> <%= stats.level.label %></span>
      <% if (theme.tier === 'core') { %><span class="qtag real">núcleo da prova</span><% } else { %><span class="qtag">complemento</span><% } %>
      <% if (theme.is_special) { %><span class="qtag obra">obra do ano</span><% } %>
      <h2 style="margin-bottom:4px;"><%= theme.name %></h2>
      <p class="muted small" style="margin-top:0;"><%= subject.name %> · cai em média <strong>≈ <%= theme.expected_per_exam.toFixed(1).replace('.', ',') %> questão(ões) por prova</strong> (apareceu <%= theme.exam_hits %> vezes nas provas de 2016–2026).</p>
      <% if (stats.attempts > 0) { %>
        <p class="muted small">Você já respondeu <%= stats.attempts %> questões deste tópico, com <%= Math.round((stats.accuracy || 0) * 100) %>% de acerto recente.</p>
      <% } %>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <a class="btn" href="/rayane/praticar/<%= theme.id %>">Praticar (<%= questionCount %> questões)</a>
        <% if (wrongCount > 0) { %><a class="btn btn-outline" href="/rayane/praticar/<%= theme.id %>?modo=erros">Refazer meus erros (<%= wrongCount %>)</a><% } %>
      </div>
      <p class="muted small" style="margin-bottom:0; margin-top:10px;">
        Banco: <%= realCount %> real(is) do CEFET-MG + <%= questionCount - realCount %> autorais ·
        N1: <%= lv[1] || 0 %> · N2: <%= lv[2] || 0 %> · N3: <%= lv[3] || 0 %>
      </p>
    </div>

    <% if (theme.theory) { %>
      <div class="card theory">
        <h2 class="mt-0">Resumo para a prova</h2>
        <%- theme.theory %>
      </div>
    <% } %>

    <% if (links.length > 0) { %>
      <div class="card">
        <h2 class="mt-0">Vídeos e artigos</h2>
        <div class="grid grid-2">
          <% links.forEach(function(l) { %>
            <a class="subject-pill" href="<%= l.url %>" target="_blank" rel="noopener">
              <span class="low-tag"><%= l.type === 'video' ? '▶ Vídeo' : '📄 Artigo' %></span>
              <div style="margin-top:6px; font-weight:600;"><%= l.title %></div>
              <div class="weight"><%= l.source %></div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</body>
</html>
